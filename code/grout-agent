# -- HTTP handler -------------------------------------------------------------

class AgentHandler(BaseHTTPRequestHandler):

    def _read_body(self):
        length = int(self.headers.get('Content-Length', 0))
        if length == 0:
            return {}
        return json.loads(self.rfile.read(length))

    def _reply(self, code, body=None):
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        if body is not None:
            self.wfile.write(json.dumps(body).encode())

    def log_message(self, fmt, *args):
        LOG.info(fmt, *args)

    # -- dispatch -------------------------------------------------------------

    def do_GET(self):
        if self.path == '/health':
            self._reply(200, {'status': 'ok'})
        elif self.path == '/routes':
            self._handle_routes_get()
        elif self.path == '/nat':
            self._handle_nat_get()
        else:
            self._reply(404, {'error': 'not found'})

    def do_PUT(self):
        handlers = {
            '/route': lambda: self._handle_route('PUT'),
            '/interface': self._handle_interface,
            '/floatingip': lambda: self._handle_floating_ip('PUT'),
            '/snat': lambda: self._handle_snat('PUT'),
            '/portforwarding': lambda: self._handle_port_forwarding('PUT'),
        }
        handler = handlers.get(self.path)
        if handler:
            handler()
        else:
            self._reply(404, {'error': 'not found'})

    def do_DELETE(self):
        handlers = {
            '/route': lambda: self._handle_route('DELETE'),
            '/floatingip': lambda: self._handle_floating_ip('DELETE'),
            '/snat': lambda: self._handle_snat('DELETE'),
            '/portforwarding': lambda: self._handle_port_forwarding('DELETE'),
        }
        handler = handlers.get(self.path)
        if handler:
            handler()
        else:
            self._reply(404, {'error': 'not found'})

    # -- route handlers -------------------------------------------------------

    def _handle_route(self, method):
        data = self._read_body()
        dest = data.get('destination')
        nexthop = data.get('nexthop')
        if not dest or not nexthop:
            self._reply(400, {'error': 'destination and nexthop required'})
            return
        try:
            if method == 'PUT':
                self.server.backend.add_route(dest, nexthop)
                LOG.info('added route %s via %s (ECMP: %s)',
                         dest, nexthop,
                         isinstance(nexthop, list) and len(nexthop) > 1)
            else:
                self.server.backend.delete_route(dest, nexthop)
                LOG.info('deleted route %s via %s', dest, nexthop)
            self._reply(200, {'status': 'ok'})
        except Exception as e:
            LOG.error('route %s failed: %s', method, e)
            self._reply(500, {'error': str(e)})

    def _handle_routes_get(self):
        try:
            routes = self.server.backend.list_routes()
            self._reply(200, {'routes': routes})
        except Exception as e:
            self._reply(500, {'error': str(e)})

    # -- interface handler ----------------------------------------------------

    def _handle_interface(self):
        data = self._read_body()
        mac = data.get('mac')
        ip_address = data.get('ip_address')
        prefix_len = data.get('prefix_len')
        gateway = data.get('gateway')
        if not mac or not ip_address or not prefix_len:
            self._reply(400, {'error': 'mac, ip_address, prefix_len required'})
            return
        try:
            iface = self.server.backend.configure_interface(
                mac, ip_address, prefix_len, gateway)
            LOG.info('configured %s/%s on %s (gw=%s)',
                     ip_address, prefix_len, iface, gateway)
            self._reply(200, {'status': 'ok', 'interface': iface})
        except ValueError as e:
            self._reply(404, {'error': str(e)})
        except Exception as e:
            self._reply(500, {'error': str(e)})

    # -- floating IP handler --------------------------------------------------

    def _handle_floating_ip(self, method):
        data = self._read_body()
        floating_ip = data.get('floating_ip')
        fixed_ip = data.get('fixed_ip')
        if not floating_ip or not fixed_ip:
            self._reply(400, {'error': 'floating_ip and fixed_ip required'})
            return
        try:
            if method == 'PUT':
                self.server.backend.add_floating_ip(floating_ip, fixed_ip)
                LOG.info('added floating IP %s -> %s', floating_ip, fixed_ip)
            else:
                self.server.backend.remove_floating_ip(floating_ip, fixed_ip)
                LOG.info('removed floating IP %s -> %s', floating_ip, fixed_ip)
            self._reply(200, {'status': 'ok'})
        except Exception as e:
            LOG.error('floating IP %s failed: %s', method, e)
            self._reply(500, {'error': str(e)})

    # -- SNAT handler ---------------------------------------------------------

    def _handle_snat(self, method):
        data = self._read_body()
        external_ip = data.get('external_ip')
        internal_cidr = data.get('internal_cidr')
        if not external_ip or not internal_cidr:
            self._reply(400,
                        {'error': 'external_ip and internal_cidr required'})
            return
        try:
            if method == 'PUT':
                self.server.backend.enable_snat(external_ip, internal_cidr)
                LOG.info('enabled SNAT %s for %s', external_ip, internal_cidr)
            else:
                self.server.backend.disable_snat(external_ip, internal_cidr)
                LOG.info('disabled SNAT %s for %s', external_ip, internal_cidr)
            self._reply(200, {'status': 'ok'})
        except Exception as e:
            LOG.error('SNAT %s failed: %s', method, e)
            self._reply(500, {'error': str(e)})

    # -- port forwarding handler ----------------------------------------------

    def _handle_port_forwarding(self, method):
        data = self._read_body()
        protocol = data.get('protocol')
        floating_ip = data.get('floating_ip')
        external_port = data.get('external_port')
        internal_ip = data.get('internal_ip')
        internal_port = data.get('internal_port')
        if not all([protocol, floating_ip, external_port,
                    internal_ip, internal_port]):
            self._reply(400, {'error': 'protocol, floating_ip, external_port, '
                                       'internal_ip, internal_port required'})
            return
        try:
            if method == 'PUT':
                self.server.backend.add_port_forwarding(
                    protocol, floating_ip, external_port,
                    internal_ip, internal_port)
                LOG.info('added port forwarding %s %s:%s -> %s:%s',
                         protocol, floating_ip, external_port,
                         internal_ip, internal_port)
            else:
                self.server.backend.remove_port_forwarding(
                    protocol, floating_ip, external_port,
                    internal_ip, internal_port)
                LOG.info('removed port forwarding %s %s:%s -> %s:%s',
                         protocol, floating_ip, external_port,
                         internal_ip, internal_port)
            self._reply(200, {'status': 'ok'})
        except Exception as e:
            LOG.error('port forwarding %s failed: %s', method, e)
            self._reply(500, {'error': str(e)})

    # -- NAT listing ----------------------------------------------------------

    def _handle_nat_get(self):
        try:
            entries = self.server.backend.list_nat()
            self._reply(200, {'nat': entries})
        except Exception as e:
            self._reply(500, {'error': str(e)})


# -- main ---------------------------------------------------------------------

BACKENDS = {
    'linux': LinuxBackend,
    'grout': GroutBackend,
}


def main():
    parser = argparse.ArgumentParser(description='Grout router agent')
    parser.add_argument('--backend', choices=BACKENDS.keys(), default='linux')
    parser.add_argument('--port', type=int, default=LISTEN_PORT)
    parser.add_argument('--config', default='/etc/grout/agent.conf')
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s %(name)s %(levelname)s %(message)s',
        stream=sys.stdout)

    conf = load_config(args.config)
    if conf.get('heartbeat_target'):
        host, port = conf['heartbeat_target'].rsplit(':', 1)
        sender = HeartbeatSender(
            host, port,
            conf['mgmt_ip'],
            conf['heartbeat_key'],
            conf.get('heartbeat_interval', 5))
        sender.start()

    backend = BACKENDS[args.backend]()
    server = HTTPServer(('0.0.0.0', args.port), AgentHandler)
    server.backend = backend
    LOG.info('grout-agent listening on port %d (backend: %s)',
             args.port, args.backend)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    server.server_close()


if __name__ == '__main__':
    main()
