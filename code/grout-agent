#!/usr/bin/python3
"""Grout agent — lightweight REST API for router VM configuration.

Runs on the management interface and receives network configuration
commands from the Neutron grout service provider.
"""

import argparse
import hashlib
import hmac
import json
import logging
import os
import socket
import subprocess
import sys
import threading
import time
from http.server import HTTPServer, BaseHTTPRequestHandler

LOG = logging.getLogger('grout-agent')
LISTEN_PORT = 9100


# -- Heartbeat sender ---------------------------------------------------------

class HeartbeatSender:
    """Sends periodic UDP heartbeats to the controller."""

    def __init__(self, target_host, target_port, mgmt_ip, key, interval):
        self._target = (target_host, int(target_port))
        self._mgmt_ip = mgmt_ip
        self._key = key.encode()
        self._interval = interval
        self._seq = 0
        self._sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

    def start(self):
        t = threading.Thread(target=self._run, daemon=True)
        t.start()
        LOG.info('heartbeat sender started -> %s:%d every %ds',
                 self._target[0], self._target[1], self._interval)

    def _run(self):
        while True:
            try:
                msg = json.dumps({
                    'mgmt_ip': self._mgmt_ip,
                    'seq': self._seq,
                }).encode()
                mac = hmac.new(self._key, msg, hashlib.sha256).hexdigest()
                self._sock.sendto(msg + mac.encode(), self._target)
                self._seq += 1
            except Exception as e:
                LOG.warning('heartbeat send failed: %s', e)
            time.sleep(self._interval)


def load_config(path):
    if not os.path.exists(path):
        return {}
    with open(path) as f:
        return json.load(f)


# -- Backend abstraction ------------------------------------------------------

class Backend:
    """Base class for network backends."""

    def add_route(self, destination, nexthop):
        raise NotImplementedError

    def delete_route(self, destination, nexthop):
        raise NotImplementedError

    def list_routes(self):
        raise NotImplementedError

    def configure_interface(self, mac, ip_address, prefix_len, gateway=None):
        raise NotImplementedError

    def add_floating_ip(self, floating_ip, fixed_ip):
        raise NotImplementedError

    def remove_floating_ip(self, floating_ip, fixed_ip):
        raise NotImplementedError

    def enable_snat(self, external_ip, internal_cidr):
        raise NotImplementedError

    def disable_snat(self, external_ip, internal_cidr):
        raise NotImplementedError

    def add_port_forwarding(self, protocol, floating_ip, external_port,
                            internal_ip, internal_port):
        raise NotImplementedError

    def remove_port_forwarding(self, protocol, floating_ip, external_port,
                               internal_ip, internal_port):
        raise NotImplementedError

    def list_nat(self):
        raise NotImplementedError


class LinuxBackend(Backend):
    """Linux kernel backend using ip and nft commands.

    Tenant interfaces, routes, and NAT rules live in the 'grout-ns'
    network namespace.  The management interface stays in the default
    namespace so the agent remains reachable from the controller.
    """

    NAMESPACE = 'grout-ns'

    def __init__(self):
        self._run_cmd(
            ['ip', 'netns', 'add', self.NAMESPACE], check=False)
        self._ns_run(['sysctl', '-w', 'net.ipv4.ip_forward=1'])
        self._ns_run(['ip', 'link', 'set', 'lo', 'up'])
        LOG.info('namespace %s ready', self.NAMESPACE)

    def _run_cmd(self, args, check=True, stdin=None):
        result = subprocess.run(
            args, capture_output=True, text=True, timeout=30, input=stdin)
        if check and result.returncode != 0:
            raise RuntimeError(
                'cmd %s failed (%d): %s' % (
                    args, result.returncode, result.stderr))
        return result.returncode, result.stdout.strip(), result.stderr.strip()

    def _ns_run(self, args, **kwargs):
        return self._run_cmd(
            ['ip', 'netns', 'exec', self.NAMESPACE] + list(args), **kwargs)

    def _find_iface_by_mac(self, mac):
        _, out, _ = self._run_cmd(['ip', '-o', 'link', 'show'])
        mac_lower = mac.lower()
        for line in out.splitlines():
            if mac_lower in line.lower():
                return line.split(':')[1].strip()
        raise ValueError('no interface with MAC %s' % mac)

    def _ensure_grout_table(self):
        rc, _, _ = self._ns_run(
            ['nft', 'list', 'table', 'ip', 'grout'], check=False)
        if rc != 0:
            self._ns_run(['nft', '-f', '-'], stdin=(
                'table ip grout {\n'
                '  chain prerouting {\n'
                '    type nat hook prerouting priority -100; policy accept;\n'
                '  }\n'
                '  chain postrouting {\n'
                '    type nat hook postrouting priority 100; policy accept;\n'
                '  }\n'
                '}\n'))

    # -- routes ---------------------------------------------------------------

    def add_route(self, destination, nexthops):
        if isinstance(nexthops, str):
            nexthops = [nexthops]
        cmd = ['ip', 'route', 'replace', destination]
        for nh in nexthops:
            cmd += ['nexthop', 'via', nh]
        rc, _, err = self._ns_run(cmd, check=False)
        if rc != 0:
            raise RuntimeError('route add failed: %s' % err)

    def delete_route(self, destination, nexthops):
        if isinstance(nexthops, str):
            nexthops = [nexthops]
        for nh in nexthops:
            rc, _, err = self._ns_run(
                ['ip', 'route', 'del', destination, 'via', nh], check=False)
            if rc != 0 and 'No such process' not in err:
                raise RuntimeError('route del failed: %s' % err)

    def list_routes(self):
        rc, out, err = self._ns_run(
            ['ip', '-j', 'route', 'show'], check=False)
        if rc != 0:
            raise RuntimeError('route list failed: %s' % err)
        return json.loads(out)

    # -- interfaces -----------------------------------------------------------

    def configure_interface(self, mac, ip_address, prefix_len, gateway=None):
        iface = self._find_iface_by_mac(mac)

        self._run_cmd(
            ['ip', 'link', 'set', iface, 'netns', self.NAMESPACE])

        rc, _, err = self._ns_run(
            ['ip', 'addr', 'add', '%s/%s' % (ip_address, prefix_len),
             'dev', iface], check=False)
        if rc != 0 and 'File exists' not in err:
            raise RuntimeError('ip addr add failed: %s' % err)

        self._ns_run(['ip', 'link', 'set', iface, 'up'], check=False)

        if gateway:
            self._ns_run(
                ['ip', 'route', 'add', 'default', 'via', gateway,
                 'dev', iface, 'metric', '100'], check=False)

        return iface

    # -- floating IP (1:1 NAT) ------------------------------------------------

    def add_floating_ip(self, floating_ip, fixed_ip):
        self._ensure_grout_table()
        comment = 'grout-fip-%s' % floating_ip
        self._ns_run(['nft', 'add', 'rule', 'ip', 'grout', 'prerouting',
                       'ip', 'daddr', floating_ip,
                       'dnat', 'to', fixed_ip,
                       'comment', '"%s"' % comment])
        self._ns_run(['nft', 'add', 'rule', 'ip', 'grout', 'postrouting',
                       'ip', 'saddr', fixed_ip,
                       'snat', 'to', floating_ip,
                       'comment', '"%s"' % comment])

    def remove_floating_ip(self, floating_ip, fixed_ip):
        self._delete_rules_by_comment('grout-fip-%s' % floating_ip)

    # -- SNAT -----------------------------------------------------------------

    def enable_snat(self, external_ip, internal_cidr):
        self._ensure_grout_table()
        comment = 'grout-snat-%s' % internal_cidr.replace('/', '_')
        self._ns_run(['nft', 'add', 'rule', 'ip', 'grout', 'postrouting',
                       'ip', 'saddr', internal_cidr,
                       'snat', 'to', external_ip,
                       'comment', '"%s"' % comment])

    def disable_snat(self, external_ip, internal_cidr):
        self._delete_rules_by_comment(
            'grout-snat-%s' % internal_cidr.replace('/', '_'))

    # -- port forwarding ------------------------------------------------------

    def add_port_forwarding(self, protocol, floating_ip, external_port,
                            internal_ip, internal_port):
        self._ensure_grout_table()
        comment = 'grout-pf-%s-%s-%s' % (protocol, floating_ip, external_port)
        self._ns_run(['nft', 'add', 'rule', 'ip', 'grout', 'prerouting',
                       'ip', 'daddr', floating_ip,
                       protocol, 'dport', str(external_port),
                       'dnat', 'to', '%s:%s' % (internal_ip, internal_port),
                       'comment', '"%s"' % comment])

    def remove_port_forwarding(self, protocol, floating_ip, external_port,
                               internal_ip, internal_port):
        self._delete_rules_by_comment(
            'grout-pf-%s-%s-%s' % (protocol, floating_ip, external_port))

    # -- NAT listing ----------------------------------------------------------

    def list_nat(self):
        rc, out, err = self._ns_run(
            ['nft', '-j', 'list', 'table', 'ip', 'grout'], check=False)
        if rc != 0:
            return []

        entries = []
        try:
            data = json.loads(out)
        except json.JSONDecodeError:
            return []

        for item in data.get('nftables', []):
            rule = item.get('rule')
            if not rule:
                continue
            comment = rule.get('comment', '')
            if comment.startswith('grout-fip-'):
                fip = comment[len('grout-fip-'):]
                fixed = self._extract_nat_target(rule)
                if fixed:
                    if rule.get('chain') == 'prerouting':
                        entries.append({
                            'type': 'floating_ip',
                            'floating_ip': fip,
                            'fixed_ip': fixed,
                        })
            elif comment.startswith('grout-snat-'):
                cidr = comment[len('grout-snat-'):].replace('_', '/')
                ext = self._extract_nat_target(rule)
                if ext:
                    entries.append({
                        'type': 'snat',
                        'external_ip': ext,
                        'internal_cidr': cidr,
                    })
            elif comment.startswith('grout-pf-'):
                parts = comment[len('grout-pf-'):].split('-', 2)
                if len(parts) >= 3:
                    target = self._extract_nat_target(rule)
                    if target and ':' in target:
                        int_ip, int_port = target.rsplit(':', 1)
                        entries.append({
                            'type': 'port_forwarding',
                            'protocol': parts[0],
                            'floating_ip': parts[1],
                            'external_port': int(parts[2]),
                            'internal_ip': int_ip,
                            'internal_port': int(int_port),
                        })
        return entries

    def _extract_nat_target(self, rule):
        for expr in rule.get('expr', []):
            if isinstance(expr, dict):
                for key in ('dnat', 'snat'):
                    nat = expr.get(key)
                    if nat and isinstance(nat, dict):
                        addr = nat.get('addr')
                        port = nat.get('port')
                        if addr and port:
                            return '%s:%s' % (addr, port)
                        if addr:
                            return str(addr)
        return None

    def _delete_rules_by_comment(self, comment):
        rc, out, _ = self._ns_run(
            ['nft', '-j', '-a', 'list', 'table', 'ip', 'grout'], check=False)
        if rc != 0:
            return
        try:
            data = json.loads(out)
        except json.JSONDecodeError:
            return
        for item in data.get('nftables', []):
            rule = item.get('rule')
            if not rule:
                continue
            if rule.get('comment', '') == comment:
                chain = rule.get('chain')
                handle = rule.get('handle')
                if chain and handle:
                    self._ns_run(
                        ['nft', 'delete', 'rule', 'ip', 'grout',
                         chain, 'handle', str(handle)], check=False)


